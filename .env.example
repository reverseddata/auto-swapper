# Copy to .env and fill in. Never commit .env.

# monitor = only ping Discord when a watched item opens up (default, safe)
# claim   = claim it on your BloxSwaps account, ping Discord, pause until traded
MODE=monitor

# Discord channel webhook: Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Optional: your Discord user ID, pinged on every claim (Developer Mode > right-click you > Copy ID)
DISCORD_MENTION_USER_ID=

# Optional Discord bot for /watch commands (manage items from Discord, no redeploys).
# Needs DISCORD_MENTION_USER_ID above: that user is the only one allowed to use it.
# See README "Managing items from Discord". Keep this token secret.
DISCORD_BOT_TOKEN=
# Optional: your server ID, so the commands show up instantly.
DISCORD_GUILD_ID=

# BloxSwaps session for claiming: the full Cookie header value from a logged-in
# bloxswaps.com tab (DevTools > Network > any api.bloxswaps.com request > Cookie).
# Put it in .env, never here. Anyone with it can act on your account. The bot renews
# the short-lived cookie itself and saves it in DATA_DIR. Paste a new value only if
# claims fail with "token was rejected" (the login itself has expired).
BLOXSWAPS_TOKEN=

# Seconds between polls. Minimum 1. A poll downloads ~600 KB when anything on the site
# changed and nothing when not. Fast polling may get rate limited; the bot then backs off.
POLL_INTERVAL_SECONDS=30

# After a claim, polling pauses until BloxSwaps reports the trade done, or this
# many minutes pass. 0 = stay paused until you run `mm2sniper resume`.
CLAIM_HOLD_TIMEOUT_MINUTES=30

# Optional safety caps, in BloxSwaps value units. Empty or 0 = off.
# MAX_CLAIM_PRICE caps any single withdraw claim; MAX_DAILY_SPEND caps the UTC day.
MAX_CLAIM_PRICE=
MAX_DAILY_SPEND=
# A withdraw claims every unit in stock that your balance and the caps above allow.
# MAX_CLAIM_QUANTITY limits units per claim (empty or 0 = no limit). Deposits give 1
# unless the item sets a max quantity (how many you have to give).
MAX_CLAIM_QUANTITY=

# Claim items that are already available when the bot starts (default: only
# react to items that become available while it runs).
ACT_ON_FIRST_SIGHT=false

# Optional quick watchlist instead of config.toml (good for Railway). Comma-separated:
#   Item<=330            withdraw, only at or below 330
#   Item@deposit>=30     deposit, only if it pays at least 30
#   Item@both<=50>=10    either side, each with its limit
#   Item<=330 x3         withdraw only when at least 3 can be taken at once
#   Item@deposit>=30 x1-4  deposit up to 4 at once (deposits default to 1)
# Claim mode refuses entries with no limit (MAX_CLAIM_PRICE counts for withdrawals).
WATCH=

LOG_LEVEL=INFO
# CONFIG_FILE=config.toml
# DATA_DIR=data
# LOG_DIR=logs
